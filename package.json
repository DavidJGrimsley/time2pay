{
  "name": "time2pay",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "mercury:backfill-vault": "node scripts/backfill-mercury-vault.mjs",
    "db:migrate:raw": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "icons:sync": "node scripts/copy-icons.mjs",
    "build:web:deploy": "node scripts/generate-seo.mjs && node scripts/export-web.mjs && node scripts/prepare-server-output.mjs && node scripts/generate-build-meta.mjs && node scripts/generate-sw.mjs",
    "build:web": "npm run icons:sync && npm run build:web:deploy",
    "serve:prod": "node server.js",
    "serve:prod:fresh": "npm run build:web:deploy && node server.js",
    "serve:prod:env": "node server.js",
    "lint": "eslint . --ignore-pattern mds",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
