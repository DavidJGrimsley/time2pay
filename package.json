    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-server": "~56.0.5",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "express": "^5.2.1",
    "lottie-react-native": "~7.3.4",
    "morgan": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
