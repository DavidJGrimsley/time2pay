    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~56.0.4",
    "react-test-renderer": "19.2.3",
    "supabase": "^2.83.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4",
    "workbox-build": "^7.4.0"
