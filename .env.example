# Copy this file to .env. Do not commit .env or put any private value behind EXPO_PUBLIC_.
#
# Choose the matching origin below. Keep the origin free of a trailing slash.
# Local:       http://localhost:8081
# Staging/test: https://lucid-lewin.108-175-12-95.plesk.page
# Production:  https://time2pay.app
#
# Mercury OAuth callback URLs to register with Mercury (exact match required):
# Local:       http://localhost:8081/api/mercury-oauth/callback
# Staging/test: https://lucid-lewin.108-175-12-95.plesk.page/api/mercury-oauth/callback
# Production:  https://time2pay.app/api/mercury-oauth/callback
# Register the staging/test callback with Mercury's sandbox client and the production callback
# with the live client. Do not use a sandbox client ID/secret in production.

# --- Required for a hosted Time2Pay deployment ---
# Local OAuth testing also uses hosted mode because it needs Supabase sign-in and token storage.
# For local SQLite-only UI work, change this to local and leave hosted-only values unused.
EXPO_PUBLIC_TIME2PAY_DATA_MODE=hosted
EXPO_PUBLIC_SITE_ORIGIN=http://localhost:8081
TIME2PAY_FAIL_BUILD_IF_LOCAL=0

# Supabase project values. Use the same project credentials for the selected environment.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Runtime connection: transaction pooler, normally port 6543 and ?pgbouncer=true.
DATABASE_URL=
# Migration connection: direct/session pooler, normally port 5432 and no pgbouncer parameter.
DATABASE_DIRECT_URL=

# --- Mercury OAuth ---
# Mercury gives these application credentials after approving the OAuth integration.
# They are not a Mercury API token. Keep the secret server-only.
MERCURY_OAUTH_CLIENT_ID=
MERCURY_OAUTH_CLIENT_SECRET=
# Local and staging/test: sandbox. Production: production.
MERCURY_OAUTH_ENVIRONMENT=sandbox

# Optional: needed only for unsigned-in tour-mode Mercury data.
MERCURY_SANDBOX_API_KEY=
MERCURY_SANDBOX_BASE_URL=https://api-sandbox.mercury.com/api/v1

# --- GitHub repository sync (optional) ---
# Leave both blank to hide Sign in with GitHub; otherwise create a GitHub OAuth app.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe billing (required only when offering hosted billing) ---
# Use Stripe test-mode values locally and on staging/test; use live-mode values only in production.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_HOSTED_ANNUAL=
STRIPE_PRICE_HOSTED_MONTHLY=
STRIPE_PRICE_MERCURY_LIFETIME=
STRIPE_WEBHOOK_SECRET=
TIME2PAY_BILLING_GRACE_DAYS=7
TIME2PAY_ENFORCE_HOSTED_ACCESS=false
