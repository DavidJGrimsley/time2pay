# Mercury integration.
# Production Mercury API keys are saved per signed-in user as Supabase Vault secrets.
# The encryption master key is managed by Supabase — no app-side secret is required for new rows.
# Do not prefix these with EXPO_PUBLIC_.
#
# MERCURY_API_KEY_ENCRYPTION_SECRET is LEGACY. It is only needed by
# `npm run mercury:backfill-vault` to decrypt rows written before the
# Vault migration. Once backfill is complete, this variable can be removed
# (and the legacy columns dropped in a future migration).
MERCURY_API_KEY_ENCRYPTION_SECRET=
MERCURY_SANDBOX_API_KEY=replace-with-your-mercury-sandbox-api-key
MERCURY_SANDBOX_BASE_URL=https://api-sandbox.mercury.com/api/v1

# Mercury contract tests (test environment only)
# Set MERCURY_CONTRACT_RUN=true to enable:
# npm run test:mercury:contract
MERCURY_CONTRACT_RUN=false
MERCURY_CONTRACT_AR_ENABLED=false
MERCURY_CONTRACT_DESTINATION_ACCOUNT_ID=
MERCURY_CONTRACT_TRANSFER_PAYLOAD_JSON=
MERCURY_CONTRACT_SEND_MONEY_ACCOUNT_ID=
MERCURY_CONTRACT_SEND_MONEY_PAYLOAD_JSON=

# GitHub OAuth configuration (optional for Sign in with GitHub).
# Server-side secret value:
GITHUB_CLIENT_SECRET=
#
# Client-visible id used by web UI and server token exchange:
EXPO_PUBLIC_GITHUB_CLIENT_ID=

# Runtime data mode:
# - local: existing expo-sqlite workflow (default)
# - hosted: Supabase Auth + Postgres workflow
EXPO_PUBLIC_TIME2PAY_DATA_MODE=local
# Public site origin used for canonical URLs and hosted auth redirects.
# Required when EXPO_PUBLIC_TIME2PAY_DATA_MODE=hosted.
# Set this per environment:
# - production: https://time2pay.app
# - test(staging): https://lucid-lewin.108-175-12-95.plesk.page
EXPO_PUBLIC_SITE_ORIGIN=
# Optional build safety guard. When true, web export fails if mode resolves to local.
# Accepted truthy values: 1, true, yes, on
TIME2PAY_FAIL_BUILD_IF_LOCAL=0

# Supabase hosted mode (required when EXPO_PUBLIC_TIME2PAY_DATA_MODE=hosted)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Transaction pooler (port 6543, ?pgbouncer=true). Used by the app at runtime.
DATABASE_URL=
# Session pooler (port 5432, no pgbouncer param). Used by drizzle migrations — DDL needs a persistent connection.
DATABASE_DIRECT_URL=
